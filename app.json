{
  "expo": {
    "name": "GCash Tracker",
    "slug": "gcash-transaction",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gcashtracker.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gcashtracker.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GCash Tracker to open your photos so you can import GCash receipt screenshots.",
          "cameraPermission": "Allow GCash Tracker to use the camera to capture GCash receipts.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "gcashtracker"
  }
}
